# ═══════════════════════════════════════
#   YOPI ON AIR — Environment Variables
#   Copy this to .env and fill in values
# ═══════════════════════════════════════

# Discord Bot Token (from discord.dev)
BOT_TOKEN=your_bot_token_here

# Your Discord Server ID
GUILD_ID=your_guild_id_here

# Channel ID where the key panel will be posted
KEY_CHANNEL_ID=your_channel_id_here

# Role ID given when a key is redeemed
SCRIPT_ROLE_ID=your_role_id_here

# Your Discord User ID (for admin commands)
ADMIN_USER_ID=your_discord_user_id_here

# URL where your YopiOnAir.lua script is hosted
# (upload to GitHub raw, pastebin, etc.)
SCRIPT_URL=https://raw.githubusercontent.com/youruser/yourrepo/main/YopiOnAir.lua

# Port (Railway sets this automatically)
PORT=3000
